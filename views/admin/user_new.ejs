<%- include('partials/admin_layout_start', { 
  pageTitle: 'Create New Author', 
  pageBreadcrumb: 'Add Author',
  topbarButton: { text: '← Back to Users', url: '/admin/users' }
}) %>

<div class="admin-card" style="max-width: 760px; margin: 0 auto;">
  <div class="admin-card-header">
    <div class="admin-card-title">
      <span>Enter Author / User Information</span>
    </div>
  </div>

  <div class="admin-card-body">
    <% if (typeof error !== 'undefined' && error) { %>
      <div style="background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px;">
        <%= error %>
      </div>
    <% } %>

    <form action="/admin/users/new" method="POST" enctype="multipart/form-data">
      <div class="admin-form-grid">
        <!-- Display Name -->
        <div class="admin-form-group">
          <label class="admin-form-label">Full Name *</label>
          <input type="text" name="display_name" class="admin-form-input" required placeholder="e.g. John Doe">
        </div>

        <!-- Username -->
        <div class="admin-form-group">
          <label class="admin-form-label">Username (lowercase alphanumeric) *</label>
          <input type="text" name="username" class="admin-form-input" required placeholder="e.g. johndoe" pattern="^[a-zA-Z0-9_-]+$">
        </div>
      </div>

      <div class="admin-form-grid">
        <!-- Email -->
        <div class="admin-form-group">
          <label class="admin-form-label">Email Address *</label>
          <input type="email" name="email" class="admin-form-input" required placeholder="author@example.com">
        </div>

        <!-- Password -->
        <div class="admin-form-group">
          <label class="admin-form-label">Initial Password *</label>
          <input type="password" name="password" class="admin-form-input" required placeholder="At least 6 characters">
        </div>
      </div>

      <div class="admin-form-grid">
        <!-- Role -->
        <div class="admin-form-group">
          <label class="admin-form-label">Role / Permissions *</label>
          <select name="role" class="admin-form-select" required>
            <option value="author" selected>Author</option>
            <option value="editor">Editor</option>
            <option value="admin">Administrator</option>
          </select>
        </div>

        <!-- Avatar -->
        <div class="admin-form-group">
          <label class="admin-form-label">Profile Avatar</label>
          <div class="payasti-image-dropzone" data-name="avatar" data-prompt="Drop avatar image here or click" data-hint="Click to browse Media Library"></div>
        </div>
      </div>

      <!-- Bio -->
      <div class="admin-form-group">
        <label class="admin-form-label">Author Bio (Optional)</label>
        <textarea name="bio" class="admin-form-textarea" rows="4" placeholder="Short biography or introduction..."></textarea>
      </div>

      <!-- Actions -->
      <div style="display: flex; align-items: center; justify-content: space-between; padding-top: 20px; border-top: 1px solid var(--admin-border);">
        <a href="/admin/users" class="btn-view-site" style="padding: 10px 20px; font-size: 16px;">Cancel</a>
        <button type="submit" class="btn-new-action" style="padding: 11px 30px; font-size: 17px;">
          Create User Account
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/admin_layout_end') %>
