<script>
  var allReviews = <%- JSON.stringify(reviews || []).replace(/</g, '\\u003c') %>;
  var reviewsMap = {};
  allReviews.forEach(function(item) {
    if (item && item.id) {
      reviewsMap[item.id] = item;
    }
  });

  var currentReview = null;

  function openDetailsModal(idOrReview) {
    var review = typeof idOrReview === 'object' ? idOrReview : reviewsMap[idOrReview];
    if (!review) return;
    currentReview = review;

    document.getElementById('modalTitle').textContent = review.title || '-';
    document.getElementById('modalAuthor').textContent = review.author_name || '-';
    
    // Status Badge
    var statusBadge = document.getElementById('modalStatusBadge');
    var st = review.status || 'pending';
    if (st === 'approved') {
      statusBadge.innerHTML = '✓ অনুমোদিত';
      statusBadge.style.background = '#eaf5e9';
      statusBadge.style.color = '#075603';
      statusBadge.style.border = '1px solid #d4f5d8';
    } else if (st === 'completed') {
      statusBadge.innerHTML = '★ সম্পন্ন';
      statusBadge.style.background = '#eaf5e9';
      statusBadge.style.color = '#075603';
      statusBadge.style.border = '1px solid #d4f5d8';
    } else if (st === 'rejected') {
      statusBadge.innerHTML = '✕ বাতিল';
      statusBadge.style.background = '#fee2e2';
      statusBadge.style.color = '#b91c1c';
      statusBadge.style.border = '1px solid #fecaca';
    } else {
      statusBadge.innerHTML = '⏳ অপেক্ষমাণ';
      statusBadge.style.background = '#fef3c7';
      statusBadge.style.color = '#92400e';
      statusBadge.style.border = '1px solid #fde68a';
    }

    // Date
    var dateEl = document.getElementById('modalDate');
    if (dateEl) {
      if (review.created_at) {
        var d = new Date(review.created_at);
        dateEl.textContent = d.toLocaleDateString('bn-BD', { year: 'numeric', month: 'short', day: 'numeric' });
      } else {
        dateEl.textContent = '-';
      }
    }

    // Email & Mobile
    var emailEl = document.getElementById('modalEmail');
    emailEl.textContent = review.email || '-';
    emailEl.href = 'mailto:' + (review.email || '');

    var mobEl = document.getElementById('modalMobile');
    mobEl.textContent = review.mobile || '-';
    mobEl.href = 'tel:' + (review.mobile || '');

    // Trx ID
    document.getElementById('modalTrx').textContent = review.transaction_id || '-';

    // Rokomari Link
    var rokWrap = document.getElementById('modalRokWrap');
    var rokEl = document.getElementById('modalRokomari');
    if (review.rokomari_url) {
      rokWrap.style.display = 'flex';
      rokEl.href = review.rokomari_url;
    } else {
      rokWrap.style.display = 'none';
    }

    // Cover Image
    var coverEl = document.getElementById('modalCover');
    var coverLink = document.getElementById('modalCoverLink');
    var coverFallback = document.getElementById('modalCoverFallback');
    if (review.cover_image) {
      coverEl.src = review.cover_image;
      coverLink.href = review.cover_image;
      coverEl.style.display = 'block';
      coverLink.style.display = 'inline-block';
      if (coverFallback) coverFallback.style.display = 'none';
    } else {
      coverEl.style.display = 'none';
      coverLink.style.display = 'none';
      if (coverFallback) coverFallback.style.display = 'flex';
    }

    // Description & Word Count
    var descText = review.description || '';
    document.getElementById('modalDesc').textContent = descText;
    var words = descText.trim() ? descText.trim().split(/\s+/).length : 0;
    document.getElementById('modalWordCount').textContent = words + ' টি শব্দ';

    // Status form
    document.getElementById('modalStatusSelect').value = review.status || 'pending';
    document.getElementById('modalAdminNotes').value = review.admin_notes || '';
    document.getElementById('modalStatusForm').action = '/admin/book-reviews/' + review.id + '/status';

    // Open Modal
    var modal = document.getElementById('reviewDetailModal');
    modal.style.display = 'flex';
  }

  function closeDetailsModal() {
    document.getElementById('reviewDetailModal').style.display = 'none';
  }

  function copyModalTrx() {
    if (!currentReview || !currentReview.transaction_id) return;
    navigator.clipboard.writeText(currentReview.transaction_id).then(function() {
      var btn = document.getElementById('copyTrxBtn');
      var orig = btn.textContent;
      btn.textContent = '✓ কপি হয়েছে!';
      setTimeout(function() { btn.textContent = orig; }, 1600);
    });
  }

  function copyAllDetails() {
    if (!currentReview) return;
    var text = "বইয়ের নাম: " + currentReview.title + "\n" +
               "লেখক: " + currentReview.author_name + "\n" +
               "ইমেইল: " + currentReview.email + "\n" +
               "মোবাইল: " + currentReview.mobile + "\n" +
               "বিকাশ ট্রানজ্যাকশন আইডি (২০০ টাকা): " + currentReview.transaction_id + "\n" +
               "রকমারি লিঙ্ক: " + (currentReview.rokomari_url || 'নেই') + "\n\n" +
               "বইটি সম্পর্কে ধারণা:\n" + currentReview.description;
    navigator.clipboard.writeText(text).then(function() {
      var btn = document.getElementById('copyAllDetailsBtn');
      var orig = btn.textContent;
      btn.textContent = '✓ সম্পূর্ণ তথ্য কপি হয়েছে!';
      setTimeout(function() { btn.textContent = orig; }, 2000);
    });
  }

  // Close modal when clicking backdrop or Escape key
  document.getElementById('reviewDetailModal').addEventListener('click', function(e) {
    if (e.target === this) {
      closeDetailsModal();
    }
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeDetailsModal();
    }
  });
</script>

