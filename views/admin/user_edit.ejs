<%- include('partials/admin_layout_start', { 
  pageTitle: 'Edit Author Profile', 
  pageBreadcrumb: 'Edit User',
  topbarButton: { text: '← Back to Users', url: '/admin/users' }
}) %>

<div class="admin-card" style="max-width: 760px; margin: 0 auto;">
  <div class="admin-card-header">
    <div class="admin-card-title">
      <span>Edit: <%= targetUser.display_name %> (@<%= targetUser.username %>)</span>
    </div>
    <div>
      <% if (targetUser.role === 'admin') { %>
        <span class="status-badge" style="background: #fef2f2; color: #dc2626;">Admin</span>
      <% } else if (targetUser.role === 'editor') { %>
        <span class="status-badge" style="background: #f1f5f9; color: #334155;">Editor</span>
      <% } else { %>
        <span class="status-badge" style="background: #eaf5e9; color: #075603;">Author</span>
      <% } %>
    </div>
  </div>

  <div class="admin-card-body">
    <% if (typeof error !== 'undefined' && error) { %>
      <div style="background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px;">
        <%= error %>
      </div>
    <% } %>

    <form action="/admin/users/<%= targetUser.id %>/edit" method="POST" enctype="multipart/form-data">
      <div class="admin-form-grid">
        <!-- Display Name -->
        <div class="admin-form-group">
          <label class="admin-form-label">Full Name *</label>
          <input type="text" name="display_name" value="<%= targetUser.display_name %>" class="admin-form-input" required>
        </div>

        <!-- Username (Readonly) -->
        <div class="admin-form-group">
          <label class="admin-form-label">Username (Read-only)</label>
          <input type="text" value="<%= targetUser.username %>" class="admin-form-input" disabled style="background: #f1f5f9; color: #64748b; cursor: not-allowed;">
        </div>
      </div>

      <div class="admin-form-grid">
        <!-- Email -->
        <div class="admin-form-group">
          <label class="admin-form-label">Email Address *</label>
          <input type="email" name="email" value="<%= targetUser.email %>" class="admin-form-input" required>
        </div>

        <!-- Role -->
        <div class="admin-form-group">
          <label class="admin-form-label">Role / Permissions *</label>
          <select name="role" class="admin-form-select" required>
            <option value="author" <%= targetUser.role === 'author' ? 'selected' : '' %>>Author</option>
            <option value="editor" <%= targetUser.role === 'editor' ? 'selected' : '' %>>Editor</option>
            <option value="admin" <%= targetUser.role === 'admin' ? 'selected' : '' %>>Administrator</option>
          </select>
        </div>
      </div>

      <!-- Password Reset -->
      <div class="admin-form-group">
        <label class="admin-form-label">New Password (leave blank to keep unchanged)</label>
        <input type="password" name="new_password" class="admin-form-input" placeholder="Enter new password (optional)">
      </div>

      <!-- Avatar -->
      <div class="admin-form-group">
        <label class="admin-form-label">Profile Avatar</label>
        <div class="payasti-image-dropzone" data-name="avatar" data-initial-url="<%= targetUser.avatar || '' %>" data-prompt="Drop avatar image here or click" data-hint="Click to browse Media Library"></div>
      </div>

      <!-- Bio -->
      <div class="admin-form-group">
        <label class="admin-form-label">Author Bio</label>
        <textarea name="bio" class="admin-form-textarea" rows="4"><%= targetUser.bio %></textarea>
      </div>

      <!-- Actions -->
      <div style="display: flex; align-items: center; justify-content: space-between; padding-top: 20px; border-top: 1px solid var(--admin-border);">
        <a href="/admin/users" class="btn-view-site" style="padding: 10px 20px; font-size: 16px;">Cancel</a>
        <button type="submit" class="btn-new-action" style="padding: 11px 30px; font-size: 17px;">
          Update Profile
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/admin_layout_end') %>
