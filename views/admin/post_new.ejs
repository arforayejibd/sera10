<%- include('partials/admin_layout_start', { 
  pageTitle: 'Create New Post', 
  pageBreadcrumb: 'New Post',
  activeMenu: 'new_post',
  topbarButton: { text: '← Back to Posts', url: '/admin/posts' }
}) %>

<!-- Official WordPress Gutenberg Core Styles -->
<link rel="stylesheet" href="/vendor/gutenberg/components.css">
<link rel="stylesheet" href="/vendor/gutenberg/block-editor.css">
<link rel="stylesheet" href="/vendor/gutenberg/core.css">
<link rel="stylesheet" href="/vendor/gutenberg/isolated-block-editor.css">
<link rel="stylesheet" href="/css/wp-gutenberg-editor.css?v=3.0">

<% if (typeof error !== 'undefined' && error) { %>
  <div style="background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; padding: 14px 18px; border-radius: 10px; margin-bottom: 24px; font-size: 15px;">
    ⚠️ <%= error %>
  </div>
<% } %>

<form id="postForm" action="/admin/posts/new" method="POST" enctype="multipart/form-data" class="wp-gutenberg-container">
  
  <!-- 1. Sticky WordPress Top Header Bar -->
  <div class="wp-editor-top-bar">
    <div class="wp-top-left">
      <div id="wpGutenbergToolsSlot">
        <!-- Gutenberg Inserter (+), Undo, Redo tools dock here -->
      </div>

      <!-- Quick Review Inserters Toolbar -->
      <div class="wp-review-quick-tools">
        <button type="button" class="wp-tool-btn" onclick="window.insertProsConsBlock();" title="Insert Pros & Cons block">
          <span>⚖️ Pros/Cons</span>
        </button>
        <button type="button" class="wp-tool-btn" onclick="window.insertProductCardBlock();" title="Insert Product Box">
          <span>📦 Product Box</span>
        </button>
        <button type="button" class="wp-tool-btn" onclick="window.insertRatingBlock();" title="Insert Rating score">
          <span>⭐ Rating</span>
        </button>
        <button type="button" class="wp-tool-btn" onclick="window.insertComparisonTableBlock();" title="Insert Comparison Table">
          <span>📊 Table</span>
        </button>
      </div>
    </div>

    <div class="wp-top-right">
      <button type="button" class="wp-btn-secondary" id="btnSaveDraft" onclick="window.saveAsDraft();">
        Save Draft
      </button>

      <button type="submit" class="wp-btn-publish" id="btnPublishPost">
        <span>Publish Post</span>
      </button>
    </div>
  </div>

  <!-- 2. Main 2-Column Layout (Canvas + Sidebar) -->
  <div class="wp-editor-grid">
    
    <!-- Left Column: Document Canvas -->
    <div class="wp-canvas-card">
      <!-- Large WordPress Title -->
      <input 
        type="text" 
        name="title" 
        id="postTitleInput" 
        class="wp-title-input" 
        required 
        placeholder="Add post title..." 
        autocomplete="off"
      >

      <!-- Live Permalink Preview & Editable English Slug -->
      <div class="wp-permalink-preview" id="wpPermalinkBox">
        <span class="wp-permalink-label">Permalink:</span>
        <span class="wp-permalink-base">/post/</span><span class="wp-permalink-url" id="wpPermalinkUrl">post-title</span>
        <input type="hidden" name="slug" id="postSlugInput" value="">
        <button type="button" class="wp-permalink-edit-btn" id="btnEditPermalink" onclick="window.togglePermalinkEdit(true);">Edit</button>
        
        <div class="wp-permalink-edit-wrap" id="permalinkEditWrap" style="display: none;">
          <input type="text" id="customSlugField" class="wp-permalink-input" placeholder="post-slug-here">
          <button type="button" class="wp-permalink-save-btn" onclick="window.saveCustomPermalink();">OK</button>
          <button type="button" class="wp-permalink-cancel-btn" onclick="window.togglePermalinkEdit(false);">Cancel</button>
        </div>
      </div>

      <!-- Gutenberg Writing Flow -->
      <div class="gutenberg-mount-container">
        <textarea name="content" id="postContentInput" style="display: none;"></textarea>
      </div>

      <!-- Realtime Word Count & Status Footer -->
      <div class="wp-editor-footer-status">
        <div class="wp-status-stats">
          <span class="wp-status-stat-item">📝 Words: <strong id="wpWordCount">0</strong></span>
          <span class="wp-status-stat-item">⏱️ Read Time: <strong id="wpReadingTime">1</strong> min</span>
        </div>
        <div>
          <span style="color: #059669; font-weight: 600;">⚡ WordPress Gutenberg Canvas</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Document Settings Sidebar -->
    <div class="wp-inspector-sidebar">
      
      <!-- Panel 1: Status & Visibility -->
      <div class="wp-inspector-card">
        <div class="wp-inspector-header">
          <span>Status & Visibility</span>
        </div>
        <div class="wp-inspector-body">
          <div class="wp-form-group">
            <label class="wp-label">Post Status</label>
            <select name="status" id="statusSelect" class="wp-select">
              <option value="publish" selected>Publish</option>
              <option value="draft">Draft</option>
              <option value="pending">Pending Review</option>
            </select>
          </div>

          <!-- Author Selector -->
          <% if (typeof authors !== 'undefined' && authors && authors.length) { %>
            <div class="wp-form-group">
              <label class="wp-label">Author</label>
              <select name="author_id" class="wp-select">
                <% authors.forEach(a => { %>
                  <option value="<%= a.id %>" <%= (user && user.id === a.id) ? 'selected' : '' %>>
                    <%= a.display_name || a.username %> (<%= a.role %>)
                  </option>
                <% }); %>
              </select>
            </div>
          <% } %>

          <!-- Rating Enable / Disable Option -->
          <div class="wp-form-group">
            <label class="wp-checkbox-label" style="margin-bottom: 6px;">
              <input type="checkbox" name="enable_rating" id="enableRatingCheckbox" value="1" onchange="document.getElementById('ratingScoreFieldWrap').style.display = this.checked ? 'block' : 'none';">
              <span>⭐ Enable rating on this post</span>
            </label>
            <div id="ratingScoreFieldWrap" style="display: none; margin-top: 8px; padding: 10px 12px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;">
              <label class="wp-label" style="font-size: 13px; margin-bottom: 4px;">Rating Score (1.0 - 5.0)</label>
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 18px; color: #f59e0b;">★</span>
                <input type="number" name="rating_score" id="ratingScoreInput" class="wp-input" step="0.1" min="1.0" max="5.0" value="4.8" placeholder="e.g. 4.8" style="font-weight: 700; width: 110px;">
                <span style="font-size: 13px; color: #64748b;">/ 5.0</span>
              </div>
              <span style="font-size: 11.5px; color: #64748b; margin-top: 4px; display: block;">Overall review rating score displayed on post.</span>
            </div>
          </div>

          <div class="wp-form-group">
            <label class="wp-checkbox-label">
              <input type="checkbox" name="is_featured" value="1">
              <span>Featured post on homepage</span>
            </label>
          </div>
        </div>
      </div>

      <!-- Panel 2: Categories -->
      <div class="wp-inspector-card wp-category-panel">
        <div class="wp-inspector-header">
          <span>Categories *</span>
          <span class="wp-badge-count" id="selectedCatCount">0 selected</span>
        </div>
        <div class="wp-inspector-body">
          
          <!-- Category Search Filter Box -->
          <div class="wp-cat-search-box">
            <span class="wp-cat-search-icon">🔍</span>
            <input 
              type="text" 
              id="categorySearchInput" 
              class="wp-cat-search-input" 
              placeholder="Search categories..." 
              autocomplete="off"
              oninput="window.filterCategories(this.value)"
            >
            <button type="button" id="clearCatSearch" class="wp-cat-search-clear" onclick="window.clearCategorySearch()" style="display: none;">✕</button>
          </div>

          <!-- Category Tabs -->
          <div class="wp-cat-tabs">
            <button type="button" class="wp-cat-tab active" id="tabAllCats" onclick="window.switchCatTab('all')">All Categories</button>
            <button type="button" class="wp-cat-tab" id="tabSelectedCats" onclick="window.switchCatTab('selected')">Selected</button>
          </div>

          <!-- Scrollable Category Checklist -->
          <div class="wp-cat-checklist-container" id="categoryChecklistWrap">
            <% if (categories && categories.length) { 
                 const rootCats = categories.filter(c => !c.parent_id || c.parent_id === 0);
                 rootCats.forEach((c, idx) => {
                   const children = categories.filter(child => child.parent_id === c.id);
                   const isChecked = (typeof selectedCategoryIds !== 'undefined' && selectedCategoryIds.includes(c.id));
            %>
              <div class="wp-cat-item-group" data-cat-id="<%= c.id %>" data-cat-name="<%= c.name.toLowerCase() %>">
                <label class="wp-cat-checkbox-label root-cat">
                  <input 
                    type="checkbox" 
                    name="category_ids[]" 
                    value="<%= c.id %>" 
                    <%= isChecked ? 'checked' : '' %>
                    onchange="window.updateCategorySelectionStats()"
                  >
                  <span class="wp-cat-name"><%= c.name %></span>
                </label>
                
                <% if (children && children.length) { %>
                  <div class="wp-cat-children">
                    <% children.forEach(child => { 
                         const isChildChecked = (typeof selectedCategoryIds !== 'undefined' && selectedCategoryIds.includes(child.id));
                    %>
                      <div class="wp-cat-item-child" data-cat-id="<%= child.id %>" data-cat-name="<%= child.name.toLowerCase() %>">
                        <label class="wp-cat-checkbox-label child-cat">
                          <input 
                            type="checkbox" 
                            name="category_ids[]" 
                            value="<%= child.id %>" 
                            <%= isChildChecked ? 'checked' : '' %>
                            onchange="window.updateCategorySelectionStats()"
                          >
                          <span class="wp-cat-name">— <%= child.name %></span>
                        </label>
                      </div>
                    <% }); %>
                  </div>
                <% } %>
              </div>
            <%   });
               } %>
          </div>
          <div id="noCatFoundMsg" style="display: none; padding: 12px; font-size: 12.5px; color: #94a3b8; text-align: center;">
            No categories found.
          </div>

          <!-- Quick Add New Category Toggle -->
          <div class="wp-cat-quick-add-wrap">
            <button type="button" class="wp-cat-add-toggle-btn" id="btnToggleQuickAddCat" onclick="window.toggleQuickAddCat()">
              <span id="quickAddCatIcon">➕</span> Add New Category
            </button>

            <div class="wp-cat-quick-add-form" id="quickAddCatForm" style="display: none;">
              <input type="text" id="newCatNameInput" class="wp-input" placeholder="Category name..." style="font-size: 12.5px; margin-bottom: 8px;">
              
              <label style="font-size: 11.5px; color: #64748b; margin-bottom: 4px; display: block; font-weight: 600;">Parent Category (Optional):</label>
              <select id="newCatParentSelect" class="wp-select" style="font-size: 12px; margin-bottom: 8px;">
                <option value="0">— None (Parent) —</option>
                <% if (categories && categories.length) { 
                     categories.filter(c => !c.parent_id || c.parent_id === 0).forEach(rc => { %>
                      <option value="<%= rc.id %>"><%= rc.name %></option>
                <%   }); 
                   } %>
              </select>

              <div style="display: flex; gap: 6px;">
                <button type="button" class="wp-btn-publish" style="padding: 5px 12px; font-size: 12px; border-radius: 5px;" onclick="window.submitQuickAddCategory()">
                  Add
                </button>
                <button type="button" class="wp-btn-secondary" style="padding: 5px 10px; font-size: 12px; border-radius: 5px;" onclick="window.toggleQuickAddCat(false)">
                  Cancel
                </button>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Panel 3: Tags -->
      <div class="wp-inspector-card">
        <div class="wp-inspector-header">
          <span>Tags</span>
          <span class="wp-badge-count" id="postTagCountBadge">0</span>
        </div>
        <div class="wp-inspector-body">
          
          <!-- Auto-Suggest Tags Button -->
          <button type="button" class="wp-btn-auto-tags" id="btnAutoSuggestTags" onclick="window.autoSuggestBilingualTags()">
            <span>⚡ Auto-suggest tags from content</span>
          </button>

          <!-- Interactive Tag Chips Container -->
          <div class="wp-tag-chips-wrap" id="tagChipsWrap" onclick="document.getElementById('postTagInputField').focus()">
            <!-- Dynamic tag chips inserted here -->
          </div>

          <!-- Hidden Input for Form Submission -->
          <input type="hidden" name="tags" id="hiddenPostTagsInput" value="">

          <!-- Tag Input Field & Add Button -->
          <div class="wp-tag-input-row">
            <input 
              type="text" 
              id="postTagInputField" 
              class="wp-tag-input" 
              placeholder="Type tag and press Enter or comma..."
              autocomplete="off"
            >
            <button type="button" class="wp-btn-add-tag" onclick="window.addTagFromInput()">
              Add
            </button>
          </div>
          <div style="font-size: 11px; color: #94a3b8; margin-bottom: 8px;">
            💡 Separate multiple tags with commas (<code>,</code>) or <code>Enter</code>.
          </div>

          <!-- Most Used / Existing Tags Cloud -->
          <% if (typeof allTags !== 'undefined' && allTags && allTags.length) { %>
            <div class="wp-tag-cloud-wrap">
              <span class="wp-tag-cloud-title">Choose from popular tags:</span>
              <div class="wp-tag-cloud-list">
                <% allTags.slice(0, 30).forEach(t => { %>
                  <span 
                    class="wp-tag-cloud-item" 
                    id="cloudTag_<%= t.id %>"
                    data-tag-name="<%= t.name %>" 
                    onclick="window.toggleTagFromCloud('<%= t.name.replace(/'/g, "\\'") %>')"
                  >
                    + <%= t.name %>
                  </span>
                <% }); %>
              </div>
            </div>
          <% } %>

        </div>
      </div>

      <!-- Panel 4: Featured Image -->
      <div class="wp-inspector-card">
        <div class="wp-inspector-header">
          <span>Featured Image</span>
        </div>
        <div class="wp-inspector-body">
          <div class="payasti-image-dropzone" data-name="featured_image" data-prompt="Drop image here or click to select" data-hint="Click to browse Media Library"></div>
        </div>
      </div>

      <!-- Panel 5: Excerpt / Summary -->
      <div class="wp-inspector-card">
        <div class="wp-inspector-header">
          <span>Excerpt / Summary</span>
        </div>
        <div class="wp-inspector-body">
          <textarea name="excerpt" class="wp-input" rows="3" placeholder="Write a short summary (optional)..." style="resize: vertical;"></textarea>
        </div>
      </div>

    </div>
  </div>

</form>

<!-- Official WordPress Gutenberg JS Dependencies (Local Fast Loading) -->
<script src="/vendor/gutenberg/react.min.js"></script>
<script src="/vendor/gutenberg/react-dom.min.js"></script>
<script src="/vendor/gutenberg/isolated-block-editor.js"></script>
<script src="/js/wp-smart-clipboard.js?v=2.5"></script>

<script>
  // Robust Content Sync Helper across Gutenberg isolated and core stores
  function syncGutenbergContent() {
    const textarea = document.getElementById('postContentInput');
    if (!textarea) return '';

    let syncedContent = '';

    // 1. Check Gutenberg Isolated Block Editor Store
    if (window.wp && window.wp.data && window.wp.blocks && typeof window.wp.blocks.serialize === 'function') {
      try {
        const isoStore = window.wp.data.select('isolated/editor');
        if (isoStore && typeof isoStore.getBlocks === 'function') {
          const isoBlocks = isoStore.getBlocks();
          if (isoBlocks && isoBlocks.length > 0) {
            syncedContent = window.wp.blocks.serialize(isoBlocks);
          }
        }
      } catch (e) {
        console.warn('Isolated store serialize warning:', e);
      }

      // 2. Check Core Block Editor Store
      if (!syncedContent) {
        try {
          const coreStore = window.wp.data.select('core/block-editor');
          if (coreStore && typeof coreStore.getBlocks === 'function') {
            const coreBlocks = coreStore.getBlocks();
            if (coreBlocks && coreBlocks.length > 0) {
              syncedContent = window.wp.blocks.serialize(coreBlocks);
            }
          }
        } catch (e) {
          console.warn('Core store serialize warning:', e);
        }
      }
    }

    // 3. Fallback: Existing textarea value
    if (!syncedContent && textarea.value && textarea.value.trim().length > 0) {
      syncedContent = textarea.value.trim();
    }

    // 4. Fallback: DOM HTML Extraction if block store was empty
    if (!syncedContent) {
      const editorEl = document.querySelector('.block-editor-writing-flow') ||
                       document.querySelector('.editor-styles-wrapper') ||
                       document.querySelector('.iso-editor');
      if (editorEl && editorEl.innerHTML && editorEl.innerText.trim().length > 0) {
        syncedContent = editorEl.innerHTML;
      }
    }

    if (syncedContent) {
      textarea.value = syncedContent;
    }
    return syncedContent;
  }

  // Global draft saving helper
  window.saveAsDraft = function() {
    const titleInput = document.getElementById('postTitleInput');
    if (!titleInput.value.trim()) {
      titleInput.value = 'Draft Post - ' + new Date().toLocaleDateString('en-US');
    }
    document.getElementById('statusSelect').value = 'draft';
    syncGutenbergContent();
    const form = document.getElementById('postForm');
    if (form.requestSubmit) {
      form.requestSubmit();
    } else {
      form.submit();
    }
  };

  // Tag Management State & Functions
  let currentTags = [];

  window.renderTagChips = function() {
    const wrap = document.getElementById('tagChipsWrap');
    const hiddenInput = document.getElementById('hiddenPostTagsInput');
    const badge = document.getElementById('postTagCountBadge');
    if (!wrap) return;

    wrap.innerHTML = '';
    currentTags.forEach((tagName, index) => {
      const chip = document.createElement('span');
      chip.className = 'wp-tag-chip';
      chip.innerHTML = `
        <span>#${tagName}</span>
        <button type="button" class="wp-tag-remove-btn" onclick="window.removeTagByIndex(${index})" title="Remove">✕</button>
      `;
      wrap.appendChild(chip);
    });

    if (hiddenInput) {
      hiddenInput.value = currentTags.join(',');
    }
    if (badge) {
      badge.textContent = currentTags.length;
    }

    // Update cloud selection indicators
    document.querySelectorAll('.wp-tag-cloud-item').forEach(el => {
      const name = el.getAttribute('data-tag-name');
      if (name && currentTags.some(t => t.toLowerCase() === name.toLowerCase())) {
        el.classList.add('selected');
      } else {
        el.classList.remove('selected');
      }
    });
  };

  window.addSingleTag = function(rawName) {
    if (!rawName) return;
    const name = rawName.trim().replace(/^#+/, '');
    if (name.length < 1) return;
    const lower = name.toLowerCase();
    if (!currentTags.some(t => t.toLowerCase() === lower)) {
      currentTags.push(name);
      window.renderTagChips();
    }
  };

  window.removeTagByIndex = function(index) {
    currentTags.splice(index, 1);
    window.renderTagChips();
  };

  window.toggleTagFromCloud = function(name) {
    const lower = name.toLowerCase();
    const idx = currentTags.findIndex(t => t.toLowerCase() === lower);
    if (idx >= 0) {
      currentTags.splice(idx, 1);
    } else {
      currentTags.push(name);
    }
    window.renderTagChips();
  };

  window.addTagFromInput = function() {
    const input = document.getElementById('postTagInputField');
    if (!input) return;
    const val = input.value;
    if (!val || !val.trim()) return;
    const parts = val.split(/[,,\n\r]+/);
    parts.forEach(p => window.addSingleTag(p));
    input.value = '';
    input.focus();
  };

  // Auto-Suggest Bilingual Tags from Gutenberg Content & Title
  window.autoSuggestBilingualTags = async function() {
    const btn = document.getElementById('btnAutoSuggestTags');
    const title = document.getElementById('postTitleInput') ? document.getElementById('postTitleInput').value.trim() : '';
    const content = (typeof syncGutenbergContent === 'function') ? syncGutenbergContent() : '';

    if (!title && !content) {
      alert('Please enter post title or content first.');
      return;
    }

    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<span>⏳ Analyzing tags...</span>';
    }

    try {
      const res = await fetch('/admin/api/suggest-tags', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, content })
      });
      const data = await res.json();
      if (data.success && data.tags && data.tags.length > 0) {
        data.tags.forEach(t => window.addSingleTag(t));
        if (window.showToast) {
          window.showToast(`✨ Added ${data.tags.length} relevant tags!`, 'success');
        }
      } else {
        alert('No new tags found.');
      }
    } catch (err) {
      console.error('Error suggesting tags:', err);
      alert('Error analyzing tags.');
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = '<span>⚡ Auto-Suggest Tags from Content</span>';
      }
    }
  };

  document.addEventListener('DOMContentLoaded', function() {
    const textarea = document.getElementById('postContentInput');
    
    // Initialize Tag Input key listeners
    const tagInput = document.getElementById('postTagInputField');
    if (tagInput) {
      tagInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ',') {
          e.preventDefault();
          window.addTagFromInput();
        } else if (e.key === 'Backspace' && tagInput.value === '' && currentTags.length > 0) {
          window.removeTagByIndex(currentTags.length - 1);
        }
      });
      tagInput.addEventListener('blur', function() {
        if (tagInput.value.trim()) {
          window.addTagFromInput();
        }
      });
    }

    // Render initial tag state
    window.renderTagChips();
    
    // Initialize Media Library hook
    if (window.initGutenbergMediaLibrary) {
      window.initGutenbergMediaLibrary();
    }

    // Attach Official WordPress Gutenberg Block Editor
    if (window.wp && window.wp.attachEditor) {
      window.wp.attachEditor(textarea, {
        iso: {
          moreMenu: false,
          toolbar: {
            inserter: true,
            undo: true,
            inspector: false,
            navigation: false,
            documentInspector: false,
            selectorTool: false
          }
        },
        editor: {
          hasFixedToolbar: false,
          hasInlineToolbar: true,
          mediaUpload: window.handleGutenbergMediaUpload
        }
      });

      // Safely dock Gutenberg tools into top header slot
      let attempts = 0;
      const dockInterval = setInterval(function() {
        attempts++;
        const tools = document.querySelector('.editor-document-tools') || document.querySelector('.edit-post-header__toolbar');
        const slot = document.getElementById('wpGutenbergToolsSlot');
        if (tools && slot && !slot.contains(tools)) {
          slot.appendChild(tools);
          clearInterval(dockInterval);
        }
        if (attempts > 30) clearInterval(dockInterval);
      }, 50);
    }

    // Initialize WordPress Smart Paste & Handlers
    if (window.setupWordPressSmartPaste) {
      window.setupWordPressSmartPaste('postTitleInput', 'postContentInput');
    }

    // Form Submission & Content Sync via AJAX with Post Published Popup
    const form = document.getElementById('postForm');
    const submitBtn = document.getElementById('btnPublishPost');
    const draftBtn = document.getElementById('btnSaveDraft');
    
    form.addEventListener('submit', async function(e) {
      e.preventDefault();

      const title = document.getElementById('postTitleInput').value.trim();
      if (!title) {
        if (window.showToast) {
          window.showToast('⚠️ Please enter a post title.', 'error');
        } else {
          alert('Please enter a post title.');
        }
        document.getElementById('postTitleInput').focus();
        return false;
      }

      let content = syncGutenbergContent();
      if (!content || !content.trim()) {
        if (textarea) textarea.value = '<p>' + title + '</p>';
      }

      const isDraft = document.getElementById('statusSelect').value === 'draft';
      const origSubmitHtml = submitBtn ? submitBtn.innerHTML : '';
      const origDraftHtml = draftBtn ? draftBtn.innerHTML : '';

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = isDraft ? '<span>Saving Draft... ⏳</span>' : '<span>Publishing Post... ⏳</span>';
      }
      if (draftBtn) draftBtn.disabled = true;

      try {
        const formData = new FormData(form);
        formData.append('ajax', '1');

        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json, text/plain, */*',
            'X-Requested-With': 'XMLHttpRequest'
          }
        });

        const contentType = response.headers.get('content-type') || '';
        let result = null;

        if (contentType.includes('application/json')) {
          result = await response.json();
        } else {
          // If the server redirected (e.g. 302 redirect followed to /admin/posts)
          const text = await response.text();
          if (response.ok) {
            const currentSlug = document.getElementById('postSlugInput')?.value || '';
            result = {
              success: true,
              title: title,
              slug: currentSlug,
              url: currentSlug ? '/post/' + currentSlug : '/',
              editUrl: '/admin/posts',
              status: isDraft ? 'draft' : 'publish',
              message: 'Post Published'
            };
          } else {
            throw new Error('সার্ভার থেকে ত্রুটিপূর্ণ প্রতিক্রিয়া এসেছে (' + response.status + ')');
          }
        }

        if (result && result.success) {
          // Re-enable buttons with updated label
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Update Post</span>';
          }
          if (draftBtn) {
            draftBtn.disabled = false;
            draftBtn.innerHTML = 'Save Draft';
          }

          // Update form action and slug so subsequent saves update the created post
          if (result.editUrl) form.action = result.editUrl;
          if (result.slug) {
            const slugInput = document.getElementById('postSlugInput');
            const permalinkUrl = document.getElementById('wpPermalinkUrl');
            if (slugInput) slugInput.value = result.slug;
            if (permalinkUrl) permalinkUrl.textContent = result.slug;
          }

          // Open the WordPress Floating Popup Notification!
          window.showPopupNotification(result);

        } else {
          throw new Error((result && result.error) ? result.error : 'পোস্ট সংরক্ষণ করা যায়নি');
        }
      } catch (err) {
        console.error('Post submit error:', err);
        if (window.showToast) {
          window.showToast('⚠️ ত্রুটি: ' + err.message, 'error');
        } else {
          alert('ত্রুটি: ' + err.message);
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = origSubmitHtml;
        }
        if (draftBtn) {
          draftBtn.disabled = false;
          draftBtn.innerHTML = origDraftHtml;
        }
      }
    });
  });

  // Floating Popup Notification Helpers
  let popupTimeout = null;
  let currentPublishedUrl = '';

  window.showPopupNotification = function(data) {
    const popup = document.getElementById('wpPopupNotification');
    if (!popup) return;

    const messageEl = document.getElementById('wpPopupMessage');
    const viewLink = document.getElementById('wpPopupViewLink');
    const postUrl = window.location.origin + data.url;
    currentPublishedUrl = postUrl;

    if (viewLink) viewLink.href = data.url;

    if (data.status === 'draft') {
      if (messageEl) messageEl.textContent = 'Draft saved.';
    } else if (data.status === 'pending') {
      if (messageEl) messageEl.textContent = 'Submitted for review.';
    } else {
      if (messageEl) messageEl.textContent = 'Post published.';
    }

    popup.style.display = 'flex';

    if (popupTimeout) clearTimeout(popupTimeout);
    popupTimeout = setTimeout(function() {
      window.hidePopupNotification();
    }, 10000);
  };

  window.hidePopupNotification = function() {
    const popup = document.getElementById('wpPopupNotification');
    if (popup) popup.style.display = 'none';
  };

  window.copyPublishedPostLink = function() {
    if (!currentPublishedUrl) return;
    navigator.clipboard.writeText(currentPublishedUrl).then(function() {
      const copyText = document.getElementById('wpPopupCopyText');
      if (copyText) {
        copyText.textContent = 'Copied! ✓';
        setTimeout(function() {
          copyText.textContent = 'Copy Link';
        }, 2500);
      }
    }).catch(function() {
      alert('Link: ' + currentPublishedUrl);
    });
  };

  window.saveAsDraft = function() {
    const statusSelect = document.getElementById('statusSelect');
    if (statusSelect) statusSelect.value = 'draft';
    const form = document.getElementById('postForm');
    if (form) {
      if (form.requestSubmit) form.requestSubmit();
      else form.submit();
    }
  };
</script>

<!-- WordPress-Style Floating Popup Notification -->
<div id="wpPopupNotification" class="wp-popup-notification" style="display: none;">
  <div class="wp-popup-icon">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="20 6 9 17 4 12"></polyline></svg>
  </div>
  <span class="wp-popup-message" id="wpPopupMessage">Post published.</span>
  <div class="wp-popup-actions">
    <a href="#" id="wpPopupViewLink" target="_blank" class="wp-popup-btn wp-popup-btn-view">
      View Post &nearr;
    </a>
    <button type="button" class="wp-popup-btn wp-popup-btn-copy" id="wpPopupCopyBtn" onclick="window.copyPublishedPostLink();">
      <span id="wpPopupCopyText">Copy Link</span>
    </button>
    <button type="button" class="wp-popup-close-btn" onclick="window.hidePopupNotification();" aria-label="Dismiss">&times;</button>
  </div>
</div>

<%- include('partials/admin_layout_end') %>