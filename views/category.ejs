<%- include('partials/header') %>

<main class="page-main-content py-8 sm:py-10">
  <div class="site-container">
    
    <!-- 1. Breadcrumb Navigation -->
    <nav class="archive-breadcrumb" aria-label="ব্রেডক্রাম্ব">
      <a href="/">প্রচ্ছদ</a>
      <span class="breadcrumb-sep">/</span>
      <% if (parentCategory && parentCategory.id !== category.id) { %>
        <a href="/category/<%= encodeURIComponent(parentCategory.slug) %>"><%= parentCategory.name %></a>
        <span class="breadcrumb-sep">/</span>
      <% } %>
      <span class="breadcrumb-current">
        <%= (typeof activeSubCategory !== 'undefined' && activeSubCategory) ? activeSubCategory.name : category.name %>
      </span>
    </nav>

    <!-- 2. Category Hero Header Card -->
    <% 
      const currentTitle = (typeof activeSubCategory !== 'undefined' && activeSubCategory) ? activeSubCategory.name : category.name;
      const totalCount = pagination ? pagination.totalItems : (posts ? posts.length : 0);
      const isSera10 = (category.slug === 'sera-10-lists' || currentTitle.includes('১০') || currentTitle.includes('10'));
      const catIcon = isSera10 ? '🏆' : (category.slug === 'tech' ? '💻' : (category.slug === 'books' ? '📚' : (category.slug === 'fashion' ? '👗' : (category.slug === 'health-and-wellness' ? '🌿' : '✨'))));
    %>
    
    <header class="archive-hero-header">
      <div class="archive-header-top">
        <div class="archive-header-info">
          <div class="archive-badge-pill">
            <span><%= catIcon %></span>
            <span><%= isSera10 ? 'সেরা ১০ বাছাই ও এক্সক্লুসিভ রিভিউ' : 'বিভাগীয় সংগ্রহ ও পণ্য রিভিউ' %></span>
          </div>

          <h1 class="archive-title">
            <span><%= currentTitle %></span>
          </h1>

          <p class="archive-desc">
            <% if (category.description && category.description.trim()) { %>
              <%= category.description %>
            <% } else if (isSera10) { %>
              বাংলাদেশে শীর্ষ ১০টি পণ্যের নিরপেক্ষ বিশ্লেষণ, সেরা বাছাই, বাস্তব রেটিং এবং সঠিক সিদ্ধান্ত নেওয়ার পরিপূর্ণ ক্রেতা গাইডলাইন।
            <% } else { %>
              <%= currentTitle %> ক্যাটাগরির সকল সেরা প্রোডাক্ট রিভিউ, রেটিং ও প্রয়োজনীয় কেনাকাটার পরামর্শ এক নজরে।
            <% } %>
          </p>

          <!-- Stats Chips Row -->
          <div class="archive-stats-row">
            <div class="archive-stat-chip stat-highlight">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width: 16px; height: 16px; display: inline-block;">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
              </svg>
              <span>মোট <strong><%= toBengaliNumber(totalCount) %>টি</strong> রিভিউ ও তালিকা</span>
            </div>

            <div class="archive-stat-chip">
              <span style="color: #f59e0b;">★</span>
              <span>গড় রেটিং: <strong>৪.৮/৫</strong></span>
            </div>

            <div class="archive-stat-chip">
              <span>🛡️</span>
              <span>১০০% নিরপেক্ষ যাচাই</span>
            </div>

            <div class="archive-stat-chip">
              <span>⚡</span>
              <span>সদ্য আপডেটেড</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 3. Subcategories Navigation Pills (if available) -->
      <% if (subcategories && subcategories.length) { 
           const currentParent = (typeof parentCategory !== 'undefined' && parentCategory) ? parentCategory : category;
      %>
        <div class="archive-nav-pills-bar">
          <span style="font-size: 13px; font-weight: 700; color: var(--text-muted); margin-right: 4px; white-space: nowrap;">
            উপ-বিভাগ:
          </span>
          <a href="/category/<%= encodeURIComponent(currentParent.slug) %>" class="archive-nav-pill <%= !activeSubSlug ? 'active' : '' %>">
            <span>সকল <%= currentParent.name %></span>
          </a>
          <% subcategories.forEach(sub => { 
               const isActive = activeSubSlug && (activeSubSlug === sub.slug || decodeURIComponent(activeSubSlug) === sub.slug);
          %>
            <a href="<%= sub.url ? sub.url : ('/category/' + encodeURIComponent(currentParent.slug) + '/' + encodeURIComponent(sub.slug)) %>" class="archive-nav-pill <%= isActive ? 'active' : '' %>">
              <span><%= sub.name %></span>
              <% if (sub.count) { %>
                <span class="pill-badge-count"><%= toBengaliNumber(sub.count) %></span>
              <% } %>
            </a>
          <% }) %>
        </div>
      <% } %>
    </header>

    <!-- 4. Spotlight Bento Card (Displayed on Page 1 if posts exist) -->
    <% if (pagination && pagination.currentPage === 1 && posts && posts.length > 0 && (!sort || sort === 'latest')) { 
         const spotlight = posts[0];
    %>
      <section class="archive-spotlight-card" aria-label="স্পটলাইট ফিচার্ড পোস্ট">
        <div class="archive-spotlight-media">
          <% if (spotlight.featured_image) { %>
            <img 
              src="<%= spotlight.featured_image %>" 
              alt="<%= spotlight.title %>" 
              class="archive-spotlight-img"
              loading="eager"
            >
          <% } else { %>
            <div style="width: 100%; height: 100%; min-height: 280px; background: linear-gradient(135deg, var(--brand-primary), #075603); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 40px;">
              🏆
            </div>
          <% } %>

          <div class="archive-spotlight-rank-badge">
            <span>👑 #১ শীর্ষ পছন্দ</span>
          </div>

          <% if (Number(spotlight.rating_score || 0) > 0) { %>
            <div class="archive-spotlight-score-badge">
              <span>★ <%= toBengaliNumber(parseFloat(spotlight.rating_score).toFixed(1)) %>/৫</span>
            </div>
          <% } %>
        </div>

        <div class="archive-spotlight-content">
          <div>
            <% if (spotlight.category_name) { %>
              <span class="archive-spotlight-tag"><%= spotlight.category_name %> • এক্সক্লুসিভ গাইড</span>
            <% } %>

            <h2 class="archive-spotlight-title">
              <a href="/post/<%= encodeURIComponent(spotlight.slug || '') %>">
                <%= spotlight.title %>
              </a>
            </h2>

            <p class="archive-spotlight-desc">
              <%- formatCardExcerpt(spotlight.content || spotlight.excerpt, 32, 2) %>
            </p>
          </div>

          <div class="archive-spotlight-footer">
            <div class="archive-spotlight-date">
              📅 <%= formatBengaliDate(spotlight.published_at || spotlight.created_at) %>
            </div>

            <a href="/post/<%= encodeURIComponent(spotlight.slug || '') %>" class="btn-cta-review">
              <span>বিস্তারিত পড়ুন</span>
              <span>&raquo;</span>
            </a>
          </div>
        </div>
      </section>
    <% } %>

    <!-- 5. Interactive Filter & Sorting Toolbar -->
    <div class="archive-toolbar">
      <div class="archive-toolbar-left">
        <div class="archive-filter-label">
          <span>⚡ সাজান:</span>
        </div>

        <% 
          const currentBase = pagination ? pagination.basePath.split('?')[0] : '';
          const currentSort = sort || 'latest';
        %>
        <div class="archive-sort-pills">
          <a href="<%= currentBase %>?sort=latest" class="archive-sort-btn <%= currentSort === 'latest' ? 'active' : '' %>">
            <span>🆕 সবশেষ প্রকাশিত</span>
          </a>
          <a href="<%= currentBase %>?sort=popular" class="archive-sort-btn <%= currentSort === 'popular' ? 'active' : '' %>">
            <span>🔥 সর্বাধিক পঠিত</span>
          </a>
          <a href="<%= currentBase %>?sort=rating" class="archive-sort-btn <%= currentSort === 'rating' ? 'active' : '' %>">
            <span>⭐ সেরা রেটিং</span>
          </a>
        </div>
      </div>

      <div class="archive-toolbar-right">
        <!-- Client-side Quick Instant Filter Input -->
        <div class="archive-search-box">
          <span class="archive-search-icon">🔍</span>
          <input 
            type="text" 
            id="archiveQuickSearch" 
            class="archive-search-input" 
            placeholder="এই পেজে খুঁজুন..."
            autocomplete="off"
          >
        </div>

        <div class="archive-count-badge">
          <span>মোট: <%= toBengaliNumber(totalCount) %>টি</span>
        </div>
      </div>
    </div>

    <!-- 6. Main Posts Grid (3-Column layout) -->
    <div class="archive-posts-grid" id="archivePostsGrid">
      <% if (posts && posts.length) { %>
        <% posts.forEach((post, index) => { %>
          <div class="archive-grid-item" data-title="<%= (post.title || '').toLowerCase() %>" data-excerpt="<%= (post.excerpt || '').toLowerCase() %>">
            <%- include('partials/post_card', { post: post }) %>
          </div>
        <% }) %>
      <% } else { %>
        <div class="archive-empty-box">
          <div class="archive-empty-icon">🔍</div>
          <h3 class="archive-empty-title">এই বিভাগে কোনো রিভিউ পাওয়া যায়নি</h3>
          <p class="archive-empty-desc">শীঘ্রই নতুন রিভিউ ও কেনাকাটার সেরা ১০ তালিকা যোগ করা হবে।</p>
          <a href="/" class="btn-cta-review" style="display: inline-flex;">
            <span>« মূল পাতায় ফিরে যান</span>
          </a>
        </div>
      <% } %>
    </div>

    <!-- No live search results feedback placeholder -->
    <div id="noLiveSearchResults" class="archive-empty-box" style="display: none;">
      <div class="archive-empty-icon">🔎</div>
      <h3 class="archive-empty-title">আপনার খোঁজা অনুযায়ী কোনো আর্টিকেল পাওয়া যায়নি</h3>
      <p class="archive-empty-desc">বানান পরীক্ষা করুন অথবা অন্য কোনো কীওয়ার্ড দিয়ে চেষ্টা করুন।</p>
    </div>

    <!-- 7. Pagination Component -->
    <% if (typeof pagination !== 'undefined' && pagination && pagination.totalPages > 1) { %>
      <div class="mt-8">
        <%- include('partials/pagination', { pagination: pagination }) %>
      </div>
    <% } %>

    <!-- 8. Why Trust Sera 10 Assurance Box -->
    <section style="margin-top: 56px;">
      <div class="review-section-header" style="margin-bottom: 24px;">
        <div class="section-title-wrap">
          <span class="section-title-indicator"></span>
          <h2 class="section-heading">কেন আমাদের সেরা ১০ তালিকা ও রিভিউ নির্ভরযোগ্য?</h2>
        </div>
      </div>

      <div class="affiliate-trust-grid">
        <div class="trust-promise-card">
          <div class="trust-promise-icon">🔬</div>
          <h3 class="trust-promise-title">গভীর গবেষণা ও উপাত্ত বিশ্লেষণ</h3>
          <p class="trust-promise-desc">
            প্রতিটি পণ্য তালিকার জন্য শত শত ব্যবহারকারীর রিভিউ, ল্যাব টেস্ট এবং বাস্তব পারফরম্যান্স উপাত্ত পুঙ্খানুপুঙ্খভাবে পর্যালোচনা করা হয়।
          </p>
        </div>

        <div class="trust-promise-card">
          <div class="trust-promise-icon">⚖️</div>
          <h3 class="trust-promise-title">১০০% স্বাধীন ও নিরপেক্ষ অবস্থান</h3>
          <p class="trust-promise-desc">
            কোনো ব্র্যান্ডের প্রভাব ছাড়াই পণ্যের প্রকৃত সুবিধা ও অসুবিধা সততার সাথে তুলে ধরা হয়, যাতে আপনি সঠিক সিদ্ধান্ত নিতে পারেন।
          </p>
        </div>

        <div class="trust-promise-card">
          <div class="trust-promise-icon">🇧🇩</div>
          <h3 class="trust-promise-title">বাংলাদেশ বাজার উপযোগী রেটিং</h3>
          <p class="trust-promise-desc">
            বাংলাদেশে পণ্যের প্রাপ্যতা, সার্ভিস ওয়ারেন্টি ও লোকাল মূল্যের সাথে সামঞ্জস্য রেখে সর্বোচ্চ ভ্যালু ফর মানি নির্ধারণ করা হয়।
          </p>
        </div>
      </div>
    </section>

  </div>
</main>

<!-- Live Quick Search Interaction Script -->
<script>
  (function() {
    const searchInput = document.getElementById('archiveQuickSearch');
    const postsGrid = document.getElementById('archivePostsGrid');
    const noResults = document.getElementById('noLiveSearchResults');

    if (searchInput && postsGrid) {
      searchInput.addEventListener('input', function(e) {
        const query = e.target.value.toLowerCase().trim();
        const items = postsGrid.querySelectorAll('.archive-grid-item');
        let visibleCount = 0;

        items.forEach(function(item) {
          const title = item.getAttribute('data-title') || '';
          const excerpt = item.getAttribute('data-excerpt') || '';
          if (!query || title.includes(query) || excerpt.includes(query)) {
            item.style.display = '';
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        if (noResults) {
          if (visibleCount === 0 && query !== '') {
            noResults.style.display = 'block';
            postsGrid.style.display = 'none';
          } else {
            noResults.style.display = 'none';
            postsGrid.style.display = 'grid';
          }
        }
      });
    }
  })();
</script>

<%- include('partials/footer') %>
