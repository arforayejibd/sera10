<%- include('partials/header') %>

<!-- 1. TOP AFFILIATE DISCLOSURE STRIP -->
<section class="affiliate-top-strip">
  <div class="site-container top-strip-inner">
    <div class="top-strip-left">
      <span class="top-strip-icon">✓</span>
      <span>১০০% স্বাধীন ও নিরপেক্ষ রিভিউ পোর্টাল — বাস্তব ফিচার ও ক্রেতাদের অভিজ্ঞতা ভিত্তিক বিশ্লেষণ।</span>
    </div>
    <div class="top-strip-right">
      <span>⚡ সদ্য আপডেটেড তালিকা</span>
      <span>•</span>
      <span>🇧🇩 বাংলাদেশ মার্কেট স্পেশাল</span>
    </div>
  </div>
</section>

<main class="page-main-content">
  <div class="site-container">

    <!-- 2. HERO SEARCH & VALUE PROP BANNER -->
    <section class="affiliate-hero-banner">
      <div class="hero-banner-content">
        <div class="hero-pill-badge">
          <span>✨</span>
          <span>বিশ্বস্ত ও তথ্যবহুল সেরা ১০ প্রোডাক্ট রিভিউ</span>
        </div>
        <h1 class="hero-banner-title">
          সঠিক পণ্য কেনার আগে <br><span>সেরা ১০টি তালিকার সাথে মিলিয়ে নিন</span>
        </h1>
        <p class="hero-banner-desc">
          প্রযুক্তি, বই, লাইফস্টাইল ও হোম অ্যাপ্লায়েন্সের বিশদ রিভিউ, তুলনামূলক রেটিং এবং সেরা ডিল এক ঠিকানায়।
        </p>

        <!-- Search Form -->
        <form action="/search" method="GET" class="hero-search-form">
          <div class="hero-search-input-wrap">
            <input 
              type="text" 
              name="q" 
              class="hero-search-input" 
              placeholder="কী ধরনের পণ্য বা রিভিউ খুঁজছেন? (যেমন: সেরা মোবাইল, বই, ল্যাপটপ...)" 
              required
            >
            <button type="submit" class="hero-search-btn">অনুসন্ধান</button>
          </div>
        </form>

        <!-- Trending Tags -->
        <div class="hero-trending-tags">
          <span>জনপ্রিয় সার্চ:</span>
          <a href="/search?q=স্মার্টফোন" class="hero-trending-tag-link">স্মার্টফোন</a>
          <a href="/search?q=বই" class="hero-trending-tag-link">সেরা বই</a>
          <a href="/search?q=ল্যাপটপ" class="hero-trending-tag-link">ল্যাপটপ</a>
          <a href="/search?q=ফ্রিজ" class="hero-trending-tag-link">ফ্রিজ</a>
          <a href="/search?q=ঘড়ি" class="hero-trending-tag-link">স্মার্টওয়াচ</a>
        </div>
      </div>
    </section>

    <!-- 3. LATEST BUYING GUIDES & ARTICLES GRID -->
    <section class="home-section-wrap">
      <div class="review-section-header">
        <div class="section-title-wrap">
          <span class="section-title-indicator"></span>
          <h2 class="section-heading">সর্বশেষ কেনাকাটার গাইড ও ব্লগ</h2>
        </div>
        <a href="/blog" class="section-link-more">
          <span>সকল ব্লগ দেখুন</span>
          <span>&raquo;</span>
        </a>
      </div>

      <div class="affiliate-grid-4">
        <% if (latestPosts && latestPosts.length) { %>
          <% latestPosts.slice(0, 8).forEach(post => { %>
            <%- include('partials/post_card', { post: post }) %>
          <% }) %>
        <% } else { %>
          <p style="text-align: center; color: var(--text-muted); grid-column: 1 / -1; padding: 30px;">কোনো পোস্ট পাওয়া যায়নি।</p>
        <% } %>
      </div>
    </section>

    <!-- 4. HERO MAGAZINE BENTO SHOWCASE: Editor's Choice -->
    <% if (featuredPosts && featuredPosts.length) { %>
      <section class="home-section-wrap">
        <div class="review-section-header">
          <div class="section-title-wrap">
            <span class="section-title-indicator"></span>
            <h2 class="section-heading">এই সপ্তাহের সেরা বাছাই (Editor's Choice)</h2>
          </div>
          <span class="section-header-tag">
            🔥 শীর্ষ রেটিং প্রাপ্ত
          </span>
        </div>

        <div class="hero-magazine-grid">
          
          <!-- LEFT: #1 Main Featured Post -->
          <% const heroPost = featuredPosts[0]; %>
          <div class="hero-main-card">
            <div class="hero-main-media">
              <% if (heroPost.featured_image) { %>
                <img src="<%= heroPost.featured_image %>" alt="<%= heroPost.title %>" class="hero-main-img">
              <% } %>
              <div class="hero-main-overlay"></div>
              
              <!-- Badges -->
              <div class="hero-main-badge-wrap">
                <span class="badge-rank-1">🏆 #১ সেরা পছন্দ</span>
                <% if (heroPost.category_name) { %>
                  <span class="badge-cat-tag"><%= heroPost.category_name %></span>
                <% } %>
              </div>

              <!-- Overlay Title Content -->
              <div class="hero-main-overlay-content">
                <% if (Number(heroPost.rating_score || 0) > 0) { %>
                  <div class="hero-stars-score">
                    <span>★★★★★</span>
                    <span class="score-tag">স্কোর: <%= toBengaliNumber(parseFloat(heroPost.rating_score).toFixed(1)) %>/৫</span>
                  </div>
                <% } %>
                <h3 class="hero-main-title">
                  <a href="/post/<%= encodeURIComponent(heroPost.slug || '') %>">
                    <%= heroPost.title %>
                  </a>
                </h3>
              </div>
            </div>

            <!-- Content Details -->
            <div class="hero-main-body">
              <div>
                <p class="hero-main-excerpt">
                  <%- formatCardExcerpt(heroPost.content || heroPost.excerpt, 35, 2) %>
                </p>
              </div>

              <div class="hero-main-footer">
                <span>আপডেট: <%= formatBengaliDate(heroPost.published_at || heroPost.created_at) %></span>
                <a href="/post/<%= encodeURIComponent(heroPost.slug || '') %>" class="btn-cta-review">
                  <span>বিস্তারিত পড়ুন</span>
                  <span>&raquo;</span>
                </a>
              </div>
            </div>
          </div>

          <!-- RIGHT: Top Ranked Review Cards (Rank #2 to #5) -->
          <div class="hero-side-list">
            <% featuredPosts.slice(1, 5).forEach((post, idx) => { %>
              <div class="hero-side-card">
                <a href="/post/<%= encodeURIComponent(post.slug || '') %>" class="hero-side-thumb">
                  <% if (post.featured_image) { %>
                    <img src="<%= post.featured_image %>" alt="<%= post.title %>" loading="lazy">
                  <% } %>
                  <span class="badge-rank-num">#<%= toBengaliNumber(idx + 2) %></span>
                </a>

                <div class="hero-side-info">
                  <div>
                    <div class="hero-side-cat-row">
                      <% if (post.category_name) { %>
                        <a href="/category/<%= encodeURIComponent(post.category_slug || '') %>" class="hero-side-cat">
                          <%= post.category_name %>
                        </a>
                      <% } %>
                      <% if (Number(post.rating_score || 0) > 0) { %>
                        <span class="hero-side-score">★ <%= toBengaliNumber(parseFloat(post.rating_score).toFixed(1)) %></span>
                      <% } %>
                    </div>

                    <h4 class="hero-side-title">
                      <a href="/post/<%= encodeURIComponent(post.slug || '') %>">
                        <%= post.title %>
                      </a>
                    </h4>
                  </div>

                  <div class="hero-side-bottom">
                    <span><%= formatBengaliDate(post.published_at || post.created_at) %></span>
                    <a href="/post/<%= encodeURIComponent(post.slug || '') %>" class="hero-side-link">
                      <span>বিস্তারিত পড়ুন &raquo;</span>
                    </a>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>

        </div>
      </section>
    <% } %>

    <!-- 5. CATEGORIES HUB -->
    <% if (topCategories && topCategories.length) { %>
      <section class="affiliate-categories-hub">
        <div class="category-hub-header">
          <div class="section-title-wrap">
            <span class="section-title-indicator"></span>
            <h3 class="category-hub-title">বিভাগ অনুযায়ী খুঁজুন</h3>
          </div>
          <span class="category-hub-count"><%= toBengaliNumber(topCategories.length) %>টি ক্যাটাগরি ব্রাউজ করুন</span>
        </div>

        <div class="category-hub-pills">
          <% topCategories.forEach(cat => { %>
            <a href="/category/<%= encodeURIComponent(cat.slug || '') %>" class="category-pill-item">
              <span><%= cat.name %></span>
              <span class="pill-count"><%= toBengaliNumber(cat.count) %></span>
            </a>
          <% }) %>
        </div>
      </section>
    <% } %>

    <!-- 5. TOP 10 LISTICLES SECTION -->
    <% if (topLists && topLists.length) { %>
      <section class="home-section-wrap">
        <div class="review-section-header">
          <div class="section-title-wrap">
            <span class="section-title-indicator"></span>
            <h2 class="section-heading">সেরা ১০ তালিকা ও রিকমেন্ডেশন</h2>
          </div>
          <a href="/category/sera-10-lists" class="section-link-more">
            <span>সকল তালিকা দেখুন</span>
            <span>&raquo;</span>
          </a>
        </div>

        <div class="affiliate-grid-4">
          <% topLists.slice(0, 4).forEach(post => { %>
            <%- include('partials/post_card', { post: post }) %>
          <% }) %>
        </div>
      </section>
    <% } %>

    <!-- 6. TECH & GADGETS REVIEWS SECTION -->
    <% if (techReviews && techReviews.length) { %>
      <section class="home-section-wrap">
        <div class="review-section-header">
          <div class="section-title-wrap">
            <span class="section-title-indicator"></span>
            <h2 class="section-heading">টেক ও স্মার্ট গ্যাজেট</h2>
          </div>
          <a href="/category/tech" class="section-link-more">
            <span>আরও টেক রিভিউ</span>
            <span>&raquo;</span>
          </a>
        </div>

        <div class="affiliate-grid-3">
          <% techReviews.slice(0, 3).forEach(post => { %>
            <%- include('partials/post_card', { post: post }) %>
          <% }) %>
        </div>
      </section>
    <% } %>

    <!-- 8. WHY TRUST US (PROMISES) -->
    <section class="affiliate-trust-grid">
      <div class="trust-promise-card">
        <div class="trust-promise-icon">🔍</div>
        <div class="trust-promise-content">
          <h4 class="trust-promise-title">গভীর গবেষণা ও ডেটা বিশ্লেষণ</h4>
          <p class="trust-promise-desc">
            শত শত ক্রেতার বাস্তব অভিজ্ঞতা ও টেকনিক্যাল স্পেক্স পুঙ্খানুপুঙ্খভাবে যাচাই করে সেরা তালিকা তৈরি করি।
          </p>
        </div>
      </div>

      <div class="trust-promise-card">
        <div class="trust-promise-icon">⚖️</div>
        <div class="trust-promise-content">
          <h4 class="trust-promise-title">সুবিধা ও অসুবিধার স্বচ্ছতা</h4>
          <p class="trust-promise-desc">
            শুধু ভালো দিক নয়; কেনার আগে পণ্যের সম্ভাব্য সীমাবদ্ধতা ও দুর্বলতাগুলোও পরিষ্কারভাবে তুলে ধরা হয়।
          </p>
        </div>
      </div>

      <div class="trust-promise-card">
        <div class="trust-promise-icon">💰</div>
        <div class="trust-promise-content">
          <h4 class="trust-promise-title">ভ্যালু ফর মানি রিকমেন্ডেশন</h4>
          <p class="trust-promise-desc">
            বাজেটের মধ্যে সেরা কোয়ালিটি ও আফটার-সেলস সার্ভিসের নিশ্চয়তা প্রদানকারী পণ্যগুলোকেই আমরা প্রাধান্য দিই।
          </p>
        </div>
      </div>
    </section>

    <!-- 9. BOOKS & LITERATURE SECTION -->
    <% if (bookReviews && bookReviews.length) { %>
      <section class="home-section-wrap">
        <div class="review-section-header">
          <div class="section-title-wrap">
            <span class="section-title-indicator"></span>
            <h2 class="section-heading">বই ও সাহিত্য</h2>
          </div>
          <a href="/category/books" class="section-link-more">
            <span>সকল বই তালিকা</span>
            <span>&raquo;</span>
          </a>
        </div>

        <div class="affiliate-grid-3">
          <% bookReviews.slice(0, 3).forEach(post => { %>
            <%- include('partials/post_card', { post: post }) %>
          <% }) %>
        </div>
      </section>
    <% } %>

    <!-- 10. LIFESTYLE, BEAUTY & HOME SECTION -->
    <% if (lifestyleReviews && lifestyleReviews.length) { %>
      <section class="home-section-wrap">
        <div class="review-section-header">
          <div class="section-title-wrap">
            <span class="section-title-indicator"></span>
            <h2 class="section-heading">লাইফস্টাইল ও পার্সোনাল কেয়ার</h2>
          </div>
          <a href="/category/beauty-and-personal-care" class="section-link-more">
            <span>সকল রিভিউ</span>
            <span>&raquo;</span>
          </a>
        </div>

        <div class="affiliate-grid-3">
          <% lifestyleReviews.slice(0, 3).forEach(post => { %>
            <%- include('partials/post_card', { post: post }) %>
          <% }) %>
        </div>
      </section>
    <% } %>

  </div>
</main>

<%- include('partials/footer') %>
